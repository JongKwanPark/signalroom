# Public site URL used for canonical links, sitemap, RSS and OG tags.
# signaldaily.cloud is live (DNS connected); set this in the Vercel Production env.
SITE_URL=https://signaldaily.cloud
# LLM provider used by the synthesis pipeline: openai | gemini | anthropic | openrouter
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with contact info ("Name email@example.com").
SEC_EDGAR_USER_AGENT=
# ReliefWeb API requires a pre-approved appname (https://apidoc.reliefweb.int/).
RELIEFWEB_APPNAME=
