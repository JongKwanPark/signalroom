---
import LangVerticalPage from '../../components/LangVerticalPage.astro';
import { VERTICALS, isVertical } from '../../lib/site';
export function getStaticPaths() {
  return VERTICALS.map((vertical) => ({ params: { vertical } }));
}
const { vertical } = Astro.params;
if (!vertical || !isVertical(vertical)) throw new Error('Invalid category');
---
<LangVerticalPage lang="en" vertical={vertical} path={`/${vertical}`} />
