---
import { SITE, VERTICALS, VERTICAL_META } from '../lib/site';
import { counterpartPath, getEditions, getStoryRef, langOfPath } from '../lib/editions';

const rawPath = Astro.url.pathname;
const path = rawPath.replace(/\/+$/, '') || '/';
// 3-3: 언어 prefix를 제외한 경로로 현재 위치를 판정한다(`/en/ai` ≡ `/ai`).
const barePath = path.replace(/^\/(ko|en)(?=\/|$)/, '') || '/';
// 3-3: 크롬은 영어 유지, ko↔en 전환 링크만 추가한다. 스토리 경로는
// slug 규칙(en `<base>` ↔ ko `<base>-ko`)으로 대응 경로를 치환한다.
const currentLang = langOfPath(path);
const lang = currentLang ?? 'en';
async function languageHref(target: 'ko' | 'en'): Promise<string> {
  const candidate = counterpartPath(path, target);
  const storySlug = candidate.match(/^\/(?:ko|en)\/story\/([^/]+)$/)?.[1];
  if (storySlug) return (await getStoryRef(storySlug, target)) ? candidate : `/${target}`;
  const date = candidate.match(/^\/(?:ko|en)\/(\d{4})\/(\d{2})(?:\/(\d{2}))?$/);
  if (date) {
    const editions = await getEditions();
    const prefix = `${date[1]}-${date[2]}`;
    return editions.some((edition) => edition.data.lang === target && edition.data.date.startsWith(prefix) && (!date[3] || edition.data.date === `${prefix}-${date[3]}`)) ? candidate : `/${target}`;
  }
  if (!/^\/(?:ko|en)(?:\/|$)/.test(path) && !/^\/(?:story\/|ai$|bio$|geo$|markets$|archive$|search$|\d{4}\/)/.test(path) && path !== '/') return `/${target}`;
  return candidate;
}
const koHref = await languageHref('ko');
const enHref = await languageHref('en');

function isCurrent(href: string): boolean {
  if (href === '/') return barePath === '/';
  return barePath === href || barePath.startsWith(`${href}/`);
}
---

<header class="sr-header">
  <div class="sr-container sr-header__inner">
    <a class="sr-wordmark" href={`/${lang}`} aria-label={`${SITE.name} home`}>
      <img class="sr-logo sr-logo--dark" src="/brand/logo-primary.svg" alt="" width="123" height="24" />
      <img class="sr-logo sr-logo--light" src="/brand/logo-light.svg" alt="" width="123" height="24" />
    </a>

    <nav class="sr-nav" aria-label="Vertical feeds">
      {
        VERTICALS.map((vertical) => (
          <a href={`/${lang}/${vertical}`} aria-current={isCurrent(`/${vertical}`) ? 'page' : undefined}>
            {VERTICAL_META[vertical].label}
          </a>
        ))
      }
      <a href={`/${lang}/archive`} aria-current={isCurrent('/archive') ? 'page' : undefined}>Archive</a>
    </nav>

    <div class="sr-actions">
      <nav class="sr-lang" aria-label="Language">
        <a
          href={koHref}
          hreflang="ko"
          rel="alternate"
          aria-current={currentLang === 'ko' ? 'page' : undefined}
          aria-label="한국어판으로 전환"
        >KO</a>
        <span aria-hidden="true">·</span>
        <a
          href={enHref}
          hreflang="en"
          rel="alternate"
          aria-current={currentLang === 'en' ? 'page' : undefined}
          aria-label="Switch to the English edition"
        >EN</a>
      </nav>
      <button
        class="sr-btn"
        type="button"
        data-search-open
        aria-haspopup="dialog"
        aria-keyshortcuts="Meta+K Control+K"
      >
        Search <kbd aria-hidden="true">⌘K</kbd>
      </button>
      <button
        class="sr-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch to light theme"
        aria-pressed="false"
      >
        <span data-theme-label>Light</span>
      </button>
    </div>
  </div>
</header>

<style>
  [data-theme-toggle] {
    min-width: 7.5ch;
    justify-content: center;
  }

  .sr-lang {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .sr-lang a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--sp-2);
  }

  .sr-lang a[aria-current='page'] {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
