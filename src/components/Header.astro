---
import { SITE, VERTICALS, VERTICAL_META } from '../lib/site';
import { counterpartPath, getEditions, getStoryRef, getTranslationRef, langOfPath, stripLangPrefix, verticalHref } from '../lib/editions';

const rawPath = Astro.url.pathname;
const path = rawPath.replace(/\/+$/, '') || '/';
// Story language links resolve published counterparts; absent translations lead home.
const currentLang = langOfPath(path);
const lang = currentLang ?? 'en';
async function languageHref(target: 'ko' | 'en'): Promise<string> {
  const currentSlug = stripLangPrefix(path).rest.match(/^\/story\/([^/]+)$/)?.[1];
  if (currentSlug) {
    const current = await getStoryRef(currentSlug, lang);
    const translated = current ? await getTranslationRef(current, target) : undefined;
    return translated?.href ?? `/${target}`;
  }
  const candidate = counterpartPath(path, target);
  const date = candidate.match(/^\/(?:ko|en)\/(\d{4})\/(\d{2})(?:\/(\d{2}))?$/);
  if (date) {
    const editions = await getEditions();
    const prefix = `${date[1]}-${date[2]}`;
    return editions.some((edition) => edition.data.lang === target && edition.data.date.startsWith(prefix) && (!date[3] || edition.data.date === `${prefix}-${date[3]}`)) ? candidate : `/${target}`;
  }
  if (!/^\/(?:ko|en)(?:\/|$)/.test(path) && !/^\/(?:story\/|ai$|bio$|geo$|markets$|wisdom$|society$|archive$|search$|\d{4}\/)/.test(path) && path !== '/') return `/${target}`;
  return candidate;
}
const koHref = await languageHref('ko');
const enHref = await languageHref('en');

// 단일 언어 토글: 현재 언어의 대응 언어 하나만 보여준다.
const toggle = lang === 'ko'
  ? { href: enHref, hreflang: 'en', label: 'EN', ariaLabel: 'Switch to the English edition' }
  : { href: koHref, hreflang: 'ko', label: 'KO', ariaLabel: '한국어판으로 전환' };
---

<header class="sr-header">
  <div class="sr-container sr-header__inner">
    <a class="sr-wordmark" href={`/${lang}`} aria-label={`${SITE.name} home`}>
      <img class="sr-logo sr-logo--dark" src="/brand/logo-primary.svg" alt="" width="164" height="32" />
      <img class="sr-logo sr-logo--light" src="/brand/logo-light.svg" alt="" width="164" height="32" />
    </a>

    <div class="sr-actions">
      <nav class="sr-lang" aria-label="Language">
        <a
          href={toggle.href}
          hreflang={toggle.hreflang}
          rel="alternate"
          aria-label={toggle.ariaLabel}
        >{toggle.label}</a>
      </nav>
      <button
        class="sr-btn"
        type="button"
        data-search-open
        aria-haspopup="dialog"
        aria-keyshortcuts="Meta+K Control+K"
      >
        Search <kbd aria-hidden="true">⌘K</kbd>
      </button>
      <button
        class="sr-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch to light theme"
        aria-pressed="false"
      >
        <span data-theme-label>Light</span>
      </button>
    </div>
  </div>
  <nav class="sr-container sr-category-nav sr-micro" aria-label={lang === 'ko' ? '카테고리' : 'Categories'}>
    {VERTICALS.map((vertical) => (
      <a href={verticalHref(vertical, lang)} data-vertical={vertical}
        aria-current={stripLangPrefix(path).rest === `/${vertical}` ? 'page' : undefined}>
        {VERTICAL_META[vertical].label}
      </a>
    ))}
  </nav>
</header>

<style>
  [data-theme-toggle] {
    min-width: 7.5ch;
    justify-content: center;
  }

  .sr-lang a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--sp-2);
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
