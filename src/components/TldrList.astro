---
interface Props {
  items: string[];
  label?: string;
  compact?: boolean;
}

const { items, label = 'TL;DR', compact = false } = Astro.props;
---

<div class:list={['sr-tldr', compact && 'sr-tldr--compact']}>
  <p class="sr-micro sr-micro--accent sr-tldr__label">{label}</p>
  <ol class="sr-tldr__list">
    {
      items.map((item, index) => (
        <li>
          <span class="sr-tldr__n" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span>{item}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .sr-tldr__label {
    margin-bottom: var(--sp-2);
  }

  .sr-tldr__list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  /* Story page: items sit beside 17px body copy, so they read at body size. The compact (home)
     variant keeps the global 13px / tight rhythm. */
  .sr-tldr:not(.sr-tldr--compact) :global(li) {
    font-size: var(--fs-base);
    line-height: 1.5;
  }

  .sr-tldr:not(.sr-tldr--compact) :global(.sr-tldr__n) {
    padding-top: 5px;
  }

  .sr-tldr--compact .sr-tldr__list {
    gap: var(--sp-2);
  }
</style>
