---
import { SITE, VERTICALS, VERTICAL_META } from '../lib/site';
import { getEditions, newestDate, editionsInLang } from '../lib/editions';
import { langOfPath } from '../lib/editions';
import { formatDateLong } from '../lib/format';

const lang = langOfPath(Astro.url.pathname) ?? 'en';
const editions = editionsInLang(await getEditions(), lang);
const latest = newestDate(editions);
const year = new Date().getUTCFullYear();
---

<footer class="sr-footer">
  <div class="sr-container">
    <div class="sr-footer__grid">
      <div class="sr-stack-sm">
        <p>
          <span class="sr-visually-hidden">{SITE.name}</span>
          <img class="sr-logo sr-logo--dark" src="/brand/logo-primary.svg" alt="" width="123" height="24" />
          <img class="sr-logo sr-logo--light" src="/brand/logo-light.svg" alt="" width="123" height="24" />
        </p>
        <p>{SITE.tagline} Public, no login, no tracking.</p>
        <p class="sr-micro">
          Sourced news · authored essays, features &amp; analysis · not advice
        </p>
      </div>

      <nav class="sr-footer__links sr-micro" aria-label="Category feeds">
        <span>Feeds</span>
        {
          VERTICALS.map((vertical) => (
            <a href={`/${lang}/${vertical}`}>{VERTICAL_META[vertical].label} — {VERTICAL_META[vertical].name}</a>
          ))
        }
      </nav>

      <nav class="sr-footer__links sr-micro" aria-label="Site">
        <span>Site</span>
        <a href={`/${lang}/archive`}>Archive</a>
        <a href={`/${lang}/search`}>Search</a>
        <a href="/sources">Sources</a>
        <a href="/standards">Standards</a>
        <a href="/about">About</a>
        <a href={`/${lang}/rss.xml`}>RSS</a>
      </nav>
    </div>

    <div class="sr-footer__bottom sr-micro">
      <span>© {year} {SITE.name}</span>
      <span>{latest ? `Latest edition ${formatDateLong(latest)}` : 'Awaiting first edition'}</span>
      <span>Timezone: UTC</span>
    </div>
  </div>
</footer>
