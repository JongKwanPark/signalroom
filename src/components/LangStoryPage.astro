---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CitationChip from './CitationChip.astro';
import ClusterLinks from './ClusterLinks.astro';
import EditorNote from './EditorNote.astro';
import TldrList from './TldrList.astro';
import TypeBadge from './TypeBadge.astro';
import VerticalChip from './VerticalChip.astro';
import WhyItMatters from './WhyItMatters.astro';
import {
  editionHref,
  getEditions,
  storyHref,
  timeLabel,
  verticalHref,
  sourceCount,
  type Lang,
  type StoryRef,
} from '../lib/editions';
import { CONFIDENCE_LABEL, VERTICAL_META } from '../lib/site';
import { formatDateLong, pluralize } from '../lib/format';
import { articleJsonLd, breadcrumbJsonLd } from '../lib/seo';

interface Props {
  ref: StoryRef;
  lang: Lang;
}

const { ref, lang } = Astro.props as Props;
const { story, vertical } = ref;
const meta = VERTICAL_META[vertical];
const articleEntry = ref.kind === 'article' ? await getEntry('articles', ref.articleId) : undefined;
if (ref.kind === 'article' && !articleEntry) throw new Error(`Missing article content: ${ref.articleId}`);
const renderedArticle = articleEntry ? await render(articleEntry) : undefined;
const ArticleContent = renderedArticle?.Content;
const publishedTime = ref.kind === 'article' ? ref.publishedAt : ref.generatedAt;
const modifiedTime = ref.kind === 'article' ? (ref.updatedAt ?? ref.publishedAt) : ref.generatedAt;

const sourcesById = new Map(story.sources.map((source) => [source.id, source]));
const orderedSources = [...story.sources].sort((a, b) => a.id - b.id);

const editions = ref.kind === 'edition' ? await getEditions() : [];
const edition = editions.find((entry) => entry.id === ref.editionId);
const siblings = edition?.data.stories ?? [];
const position = siblings.findIndex((item) => item.slug === ref.slug);
const previous = position > 0 ? siblings[position - 1] : null;
const following = position >= 0 && position < siblings.length - 1 ? siblings[position + 1] : null;

// Canonical, breadcrumbs and OG image all use this story's language.
const ogImage = `/og/${lang}/${ref.slug}.png`;

const jsonLd = [
  articleJsonLd(ref, { image: ogImage }),
  breadcrumbJsonLd([
    { name: 'Home', path: `/${lang}` },
    { name: meta.name, path: verticalHref(vertical, lang) },
    ...(ref.kind === 'edition' ? [{ name: formatDateLong(ref.date), path: editionHref(ref.date, lang) }] : []),
    { name: story.headline, path: ref.href },
  ]),
];

function hostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

<BaseLayout
  title={story.headline}
  description={story.dek ?? story.tldr[0]}
  path={ref.href}
  type="article"
  image={ogImage}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  jsonLd={jsonLd}
  vertical={vertical}
>
  <nav class="sr-micro sr-story-crumbs" aria-label="Breadcrumb">
    <a href={`/${lang}`}>Home</a>
    <span aria-hidden="true">/</span>
    {ref.kind === 'edition' && <><a href={editionHref(ref.date, lang)}>{formatDateLong(ref.date)}</a><span aria-hidden="true">/</span></>}
    <a href={verticalHref(vertical, lang)}>{meta.label}</a>
  </nav>

  <article class="sr-story">
    <header class="sr-story__head">
      <div class="sr-row__meta sr-micro">
        <VerticalChip vertical={vertical} href={verticalHref(vertical, lang)} />
        <TypeBadge type={story.type} />
        {ref.kind === 'article' ? <>
          <span>{ref.author}</span><span>·</span>
          <time datetime={publishedTime}>{formatDateLong(ref.date)}</time>
          {ref.updatedAt && ref.updatedAt !== ref.publishedAt && <><span>·</span><span>Updated <time datetime={ref.updatedAt}>{formatDateLong(ref.updatedAt.slice(0, 10))}</time></span></>}
          <span>·</span><span>{story.readMinutes} min</span>
        </> : <>
          <span>{pluralize(sourceCount(story), 'source')}</span><span>·</span>
          <span>{story.readMinutes} min</span><span>·</span>
          <span>cluster {story.cluster.length}</span><span>·</span>
          <span>updated {timeLabel(ref.generatedAt)} UTC</span>
        </>}

      </div>

      <h1 style={`view-transition-name: story-${ref.slug}`}>{story.headline}</h1>
      {story.dek && <p class="sr-story__dek">{story.dek}</p>}
    </header>

    {ref.kind === 'article' ? <div class="sr-story__body sr-prose sr-article-body">{ArticleContent && <ArticleContent />}</div> : <>
    <div class="sr-story__body">
      <TldrList items={story.tldr} />

      {
        story.body.map((block) => (
          <p>
            {block.text}
            <span class="sr-cites">
              {block.citations.map((citationId) => {
                const citation = sourcesById.get(citationId);
                return citation ? <CitationChip citation={citation} /> : null;
              })}
            </span>
          </p>
        ))
      }
    </div>

    <div class="sr-story__aside">
      <WhyItMatters text={story.whyItMatters} />
      <EditorNote text={story.editorNote} />
    </div>

    </>}
    <div class="sr-story__footer">
      {ref.kind === 'edition' && <ClusterLinks links={story.cluster} />}

      {orderedSources.length > 0 && <section class="sr-section" aria-labelledby="sources-heading">
        <div class="sr-section__head">
          <h2 class="sr-section__title" id="sources-heading">
            {ref.kind === 'article' ? 'References' : 'Sources'}
          </h2>
          <span class="sr-micro">{pluralize(orderedSources.length, 'citation')} · external</span>
        </div>
        <ol>
          {
            orderedSources.map((source) => (
              <li class="sr-source" id={`source-${source.id}`}>
                <span class="sr-source__n">[{source.id}]</span>
                <div>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    aria-label={`Open ${source.source}${source.title ? `: ${source.title}` : ''} in a new tab`}
                  >
                    {source.title ?? hostname(source.url)}
                    <span class="sr-ext" aria-hidden="true"> ↗</span>
                  </a>
                  <p class="sr-micro">
                    {source.source}
                    {source.publishedAt ? ` · ${source.publishedAt}` : ''} · {hostname(source.url)}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>}

      <div class="sr-actions-inline sr-story__tags">
        {ref.kind === 'edition' && <><span class="sr-micro">confidence: {CONFIDENCE_LABEL[story.confidence]}</span><span class="sr-micro" aria-hidden="true">·</span></>}
        <span class="sr-micro">
          {story.tags.map((tag) => <a class="sr-tag" href={`${verticalHref(vertical, lang)}?tag=${encodeURIComponent(tag)}`}>{tag} </a>)}
        </span>
      </div>

      {ref.kind === 'edition' ? <nav class="sr-pager sr-micro" aria-label="Story navigation">
        <span>
          {previous ? <a href={storyHref(previous.slug, lang)}>← {previous.headline}</a> : 'First in edition'}
        </span>
        <span>
          {following ? <a href={storyHref(following.slug, lang)}>{following.headline} →</a> : (
            <a href={editionHref(ref.date, lang)}>Full edition →</a>
          )}
        </span>
      </nav> : <nav class="sr-pager sr-micro" aria-label="Writing navigation"><a href={verticalHref(vertical, lang)}>← {meta.label}</a><a href={`/${lang}/archive`}>All writing →</a></nav>}
    </div>
  </article>
</BaseLayout>

<style>
  .sr-story-crumbs {
    display: flex;
    gap: var(--sp-2);
    padding-top: var(--sp-5);
  }

  .sr-story-crumbs a:hover {
    color: var(--text);
  }

  .sr-story__tags {
    margin-top: var(--sp-4);
  }
</style>
