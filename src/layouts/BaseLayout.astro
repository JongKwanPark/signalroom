---
import '../styles/global.css';
import { SITE, type Vertical } from '../lib/site';
import type { JsonLd } from '../lib/seo';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: JsonLd | JsonLd[];
  noindex?: boolean;
  vertical?: Vertical;
}

const {
  title,
  description,
  path,
  type,
  image = '/og/site.svg',
  publishedTime,
  modifiedTime,
  jsonLd,
  noindex,
  vertical,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="en" data-theme="dark" data-vertical={vertical}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0d12" />
    <script is:inline>
      // Dark is the default identity. Override only on an explicit,
      // previously stored user choice — never on OS preference.
      (function () {
        try {
          var theme = localStorage.getItem('sr-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (error) {
          /* private mode: keep server-rendered dark default */
        }
      })();
    </script>
    <SeoHead
      title={pageTitle}
      description={description}
      path={path}
      type={type}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      jsonLd={jsonLd}
      noindex={noindex}
    />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — all stories`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a class="sr-skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <div class="sr-container">
        <slot />
      </div>
    </main>
    <Footer />
    <CommandPalette />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
</style>
